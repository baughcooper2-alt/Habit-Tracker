# Postgres connection strings from your database provider (e.g. Neon, Vercel Postgres, Supabase).
# DATABASE_URL should be the pooled/serverless-friendly connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# DIRECT_URL should be a direct (non-pooled) connection string, used only for
# running migrations. If your provider doesn't distinguish the two, use the
# same value for both.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
